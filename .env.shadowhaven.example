# Faircroft Railway / Shadow Haven deployment template
# Replace every CHANGE_ME value in Railway. Do not commit real credentials.

SHADOWHAVEN_SFTP_HOST=norcom.shadowhavenhosting.net
SHADOWHAVEN_SFTP_PORT=2022
SHADOWHAVEN_SFTP_USERNAME=alien.bc50e637
SHADOWHAVEN_SFTP_PASSWORD=CHANGE_ME

SHADOWHAVEN_BANK_FILE=profile/profile/.db/FCRPMUSSALO/Banks/00bb0001-1e42-6138-7e90-c04752d4fab6.json
SHADOWHAVEN_BANK_SYNC_SECONDS=15
SHADOWHAVEN_REPUTATION_FILE=profile/profile/MedicalHud/reputation.json
SHADOWHAVEN_REPUTATION_SYNC_SECONDS=30
SHADOWHAVEN_CAMERA_EVENTS_FILE=profile/profile/FLUCKCamera/camera_events.json
SHADOWHAVEN_CAMERA_EVENTS_SYNC_SECONDS=20
SHADOWHAVEN_PERSISTENCE_ROOT=profile/profile/.db/FCRPMUSSALO
SHADOWHAVEN_PERSISTENCE_SYNC_SECONDS=120
SHADOWHAVEN_PERSISTENCE_MAX_FILES=5000
SHADOWHAVEN_PERSISTENCE_MAX_FILE_BYTES=524288
SHADOWHAVEN_PROPERTY_FILES=profile/profile/TBS Property Mod/properties.json,profile/profile/TBS Property Mod/owned-properties.json,profile/profile/TBS Property Mod/rented-properties.json
SHADOWHAVEN_PROPERTY_SYNC_SECONDS=60
SHADOWHAVEN_ANTICHEAT_DATABASE_FILE=profile/profile/TB/tb_player_database.json
SHADOWHAVEN_ANTICHEAT_ALT_FILE=profile/profile/TB/tb_alt_accounts.json
SHADOWHAVEN_ANTICHEAT_SYNC_SECONDS=30

# Testing-only developer fund issuance. Keep disabled outside controlled testing.
BANK_BRIDGE_TEST_MODE=0
SPORTS_BETTING_ENABLED=1
SPORTS_DATA_PROVIDER=kalshi
KALSHI_MARKET_DATA_ENABLED=1
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_POLL_SECONDS=30
KALSHI_SERIES_TICKERS=
KALSHI_CATEGORIES=politics,sports,technology,entertainment,video-games
SPORTSBOOK_PAYOUT_DELAY_SECONDS=5

# Use the public hostname from Railway. 0.0.0.0 is only the Arma bind address.
ARMA_A2S_HOST=216.219.91.158
ARMA_A2S_PORT=17777
ARMA_GAME_HOST=216.219.91.158
ARMA_GAME_PORT=27015

# RCON listens on its own public UDP port. The Railway password must match
# the non-empty password configured in the Shadow Haven server JSON.
ARMA_RCON_HOST=216.219.91.158
ARMA_RCON_PORT=19999
ARMA_RCON_PASSWORD=CHANGE_ME
ARMA_RCON_TIMEOUT_SECONDS=5
